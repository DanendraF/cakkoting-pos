# ==========================================
# Cak Koting Frontend — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in real values.
# NEXT_PUBLIC_* vars are exposed to the browser.

# Backend API URL (Express server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Midtrans Snap client key (Sandbox)
# Get from: https://dashboard.sandbox.midtrans.com > Settings > Access Keys
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
