# ========================================
# Cak Koting API — Environment Variables
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ----- Database -----
# Supabase: get from Project Settings > Database > Connection string (Transaction Pooler)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# For Prisma migrations use direct connection (not pooler):
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ----- Server -----
PORT=4000
NODE_ENV=development

# ----- CORS -----
# Frontend URL (Next.js dev server)
CORS_ORIGIN="http://localhost:3000"

# ----- JWT -----
# Generate a random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="ganti-dengan-random-string-panjang-minimal-64-karakter"
JWT_EXPIRES_IN="8h"

# ----- Kitchen Auth -----
# PIN untuk staf dapur (simpan di env, bukan hardcode)
KITCHEN_PIN="1234"

# ----- Admin Auth -----
ADMIN_EMAIL="admin@cakkoting.id"
# Hash dengan bcrypt sebelum simpan ke DB, atau buat endpoint /admin/setup sekali saja
ADMIN_PASSWORD_HASH="$2b$12$..."

# ----- Midtrans -----
# Sandbox keys - get from https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false
# Webhook URL (use ngrok for local testing): https://xxxxx.ngrok-free.app/api/payments/webhook
MIDTRANS_WEBHOOK_URL="https://xxxxx.ngrok-free.app/api/payments/webhook"
